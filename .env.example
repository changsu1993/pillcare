# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Get these from: https://app.supabase.com/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Environment (development | staging | production)
EXPO_PUBLIC_ENV=development

# App Configuration
EXPO_PUBLIC_APP_NAME=PillCare
EXPO_PUBLIC_SUPPORT_EMAIL=support@pillcare.app

# Deep Linking (for password reset, etc.)
EXPO_PUBLIC_APP_SCHEME=pillcare
EXPO_PUBLIC_WEB_URL=https://pillcare.app

# Push Notifications (FCM)
# Note: google-services.json and GoogleService-Info.plist are handled separately
# These are managed via EAS Secrets for production builds

# Analytics (optional)
# EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-key
# EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn
